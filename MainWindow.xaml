<Window x:Class="DrugInspectionArchive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="أرشيف كتب فحص الأدوية"
        Width="1280" Height="800"
        MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- عنصر قائمة الشركات -->
        <Style x:Key="CompanyItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowIconButton" TargetType="Button"
               BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <Style x:Key="RowDangerButton" TargetType="Button"
               BasedOn="{StaticResource RowIconButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="CellLatin" TargetType="TextBlock"
               BasedOn="{StaticResource LatinText}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- جدول الكتب: يختفي أثناء البحث -->
        <Style x:Key="BooksGridStyle" TargetType="DataGrid"
               BasedOn="{StaticResource ReviewDataGrid}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- جدول النتائج: يظهر أثناء البحث فقط -->
        <Style x:Key="ResultsGridStyle" TargetType="DataGrid"
               BasedOn="{StaticResource ReviewDataGrid}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- حقل البحث الكبير -->
        <Style x:Key="SearchShell" TargetType="Border">
            <Setter Property="Height" Value="54"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchPlaceholder" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Query}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== الشريط العلوي ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{StaticResource AccentBrush}">
                        <mi:MaterialIcon Kind="Archive" Width="21" Height="21"
                                         Foreground="White"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="أرشيف كتب فحص الأدوية"
                                   Style="{StaticResource PageTitleText}"
                                   FontSize="17"/>
                        <TextBlock Text="{Binding ArchiveSummaryText}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}"
                            Click="AddBooks_Click">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="Plus" Width="18" Height="18"/>
                            <TextBlock Text="إضافة كتب" Margin="8,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0"
                            Click="AddCompany_Click">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="Domain" Width="18" Height="18"/>
                            <TextBlock Text="شركة جديدة" Margin="8,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="22" Margin="14,0,4,0"
                            Background="{StaticResource BorderSubtleBrush}"/>

                    <Button Style="{StaticResource IconButton}"
                            Width="38" Height="38"
                            ToolTip="سلة المحذوفات"
                            Click="Trash_Click">
                        <mi:MaterialIcon Kind="DeleteOutline" Width="21" Height="21"/>
                    </Button>

                    <Button Style="{StaticResource IconButton}"
                            Width="38" Height="38"
                            ToolTip="الإعدادات"
                            Click="Settings_Click">
                        <mi:MaterialIcon Kind="Cog" Width="21" Height="21"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== منطقة البحث ===== -->
        <Border Grid.Row="1" Padding="28,22,28,6">
            <StackPanel MaxWidth="820">
                <Border Style="{StaticResource SearchShell}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <mi:MaterialIcon Kind="Magnify" Width="22" Height="22"
                                         Margin="18,0,0,0"
                                         VerticalAlignment="Center"
                                         Foreground="{StaticResource TextMutedBrush}"/>

                        <Grid Grid.Column="1" Margin="12,0">
                            <TextBlock Style="{StaticResource SearchPlaceholder}"
                                       Text="ابحث برقم التشغيلة أو اسم المادة أو الشركة"/>
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="16"
                                     VerticalContentAlignment="Center"
                                     VerticalAlignment="Center"
                                     KeyDown="SearchBox_KeyDown"/>
                        </Grid>

                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Width="32" Height="32" Margin="0,0,12,0"
                                ToolTip="مسح البحث"
                                Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"
                                Click="ClearSearch_Click">
                            <mi:MaterialIcon Kind="Close" Width="17" Height="17"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel x:Name="ModeChips"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0">
                    <RadioButton GroupName="Mode" Tag="All" Content="الكل"
                                 Style="{StaticResource SegmentButton}"
                                 Click="SearchMode_Click"/>
                    <RadioButton GroupName="Mode" Tag="Batch" Content="Batch Number"
                                 Style="{StaticResource SegmentButton}" Margin="8,0,0,0"
                                 Click="SearchMode_Click"/>
                    <RadioButton GroupName="Mode" Tag="Material" Content="المادة"
                                 Style="{StaticResource SegmentButton}" Margin="8,0,0,0"
                                 Click="SearchMode_Click"/>
                    <RadioButton GroupName="Mode" Tag="Company" Content="الشركة"
                                 Style="{StaticResource SegmentButton}" Margin="8,0,0,0"
                                 Click="SearchMode_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== المحتوى ===== -->
        <Grid Grid.Row="2" Margin="28,14,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- الشركات -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="الشركات"
                               Style="{StaticResource SectionTitleText}"
                               Margin="18,16,18,10"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Companies}"
                             SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CompanyItem}"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="8,0,8,8"
                             FlowDirection="LeftToRight"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CompanyName}"
                                               Style="{StaticResource CellLatin}"
                                               FontWeight="Medium"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TotalBooks}"
                                               Style="{StaticResource CellLatin}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12"
                                               Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- الكتب / النتائج -->
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="22,16,22,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ContentTitle}"
                                       Style="{StaticResource SectionTitleText}"
                                       FontSize="16"/>
                            <Border Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="12" Padding="10,3"
                                    Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ContentSummary}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12" FontWeight="Medium"/>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="SortChips" Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="الترتيب"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <RadioButton GroupName="Sort" Tag="Added" Content="الأحدث إضافة"
                                         Style="{StaticResource SegmentButton}"
                                         Click="Sort_Click"/>
                            <RadioButton GroupName="Sort" Tag="BookDate" Content="تاريخ الكتاب"
                                         Style="{StaticResource SegmentButton}" Margin="6,0,0,0"
                                         Click="Sort_Click"/>
                            <RadioButton GroupName="Sort" Tag="BookNumber" Content="رقم الكتاب"
                                         Style="{StaticResource SegmentButton}" Margin="6,0,0,0"
                                         Click="Sort_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- الكتب -->
                        <DataGrid x:Name="BooksGrid"
                                  Style="{StaticResource BooksGridStyle}"
                                  ItemsSource="{Binding Books}"
                                  MouseDoubleClick="BooksGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="رقم الكتاب" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BookNumberText}"
                                                       Style="{StaticResource CellLatin}"
                                                       FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="الشركة" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CompanyName}"
                                                       Style="{StaticResource CellLatin}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="تاريخ الكتاب" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BookDateText}"
                                                       Style="{StaticResource CellLatin}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="المواد" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MaterialCountText}"
                                                       Style="{StaticResource CellText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="أضيف في" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AddedDateText}"
                                                       Style="{StaticResource CellLatin}"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">
                                                <Button Style="{StaticResource RowIconButton}"
                                                        ToolTip="فتح الـ PDF"
                                                        Click="BookOpen_Click">
                                                    <mi:MaterialIcon Kind="FilePdfBox" Width="19" Height="19"/>
                                                </Button>
                                                <Button Style="{StaticResource RowIconButton}"
                                                        ToolTip="تعديل"
                                                        Click="BookEdit_Click">
                                                    <mi:MaterialIcon Kind="Pencil" Width="18" Height="18"/>
                                                </Button>
                                                <Button Style="{StaticResource RowDangerButton}"
                                                        ToolTip="نقل إلى سلة المحذوفات"
                                                        Click="BookDelete_Click">
                                                    <mi:MaterialIcon Kind="DeleteOutline" Width="19" Height="19"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- النتائج -->
                        <DataGrid x:Name="ResultsGrid"
                                  Style="{StaticResource ResultsGridStyle}"
                                  ItemsSource="{Binding Results}"
                                  MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Batch Number" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BatchNumber}"
                                                       Style="{StaticResource CellLatin}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="المادة" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MaterialName}"
                                                       Style="{StaticResource CellLatin}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="رقم الكتاب" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BookNumberText}"
                                                       Style="{StaticResource CellLatin}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="الشركة" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CompanyName}"
                                                       Style="{StaticResource CellLatin}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="التاريخ" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BookDateText}"
                                                       Style="{StaticResource CellLatin}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">
                                                <Button Style="{StaticResource RowIconButton}"
                                                        ToolTip="فتح الـ PDF"
                                                        Click="ResultOpen_Click">
                                                    <mi:MaterialIcon Kind="FilePdfBox" Width="19" Height="19"/>
                                                </Button>
                                                <Button Style="{StaticResource RowIconButton}"
                                                        ToolTip="تعديل الكتاب"
                                                        Click="ResultEdit_Click">
                                                    <mi:MaterialIcon Kind="Pencil" Width="18" Height="18"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- حالة فارغة: لا توجد كتب -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding BooksEmpty, Converter={StaticResource BoolToVis}}">
                            <mi:MaterialIcon Kind="Archive" Width="46" Height="46"
                                             Foreground="{StaticResource BorderStrongBrush}"/>
                            <TextBlock Text="لا توجد كتب بعد"
                                       FontWeight="Medium" FontSize="15"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="ابدأ بإضافة كتب الفحص من زر إضافة كتب"
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- حالة فارغة: لا توجد نتائج -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding ResultsEmpty, Converter={StaticResource BoolToVis}}">
                            <mi:MaterialIcon Kind="Magnify" Width="46" Height="46"
                                             Foreground="{StaticResource BorderStrongBrush}"/>
                            <TextBlock Text="لا توجد نتائج مطابقة"
                                       FontWeight="Medium" FontSize="15"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="جرّب تغيير نطاق البحث أو كتابة جزء آخر من النص"
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== شريط الحالة ===== -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource GhostButton}"
                        Padding="10,4" MinHeight="0"
                        ToolTip="معلومات البرنامج والإصدارات"
                        Click="About_Click">
                    <StackPanel Orientation="Horizontal">
                        <mi:MaterialIcon Kind="InformationOutline" Width="16" Height="16"/>
                        <TextBlock Text="عن البرنامج" Margin="7,0,0,0" FontSize="12"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock x:Name="VersionText" Margin="8,0,0,0" FontSize="12"
                                   Style="{StaticResource LatinText}"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>