<Window x:Class="DrugInspectionArchive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="أرشيف كتب فحص الأدوية"
        Width="1280"
        Height="800"
        MinWidth="1040"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- عنصر قائمة الشركات -->
        <Style x:Key="CompanyItem"
                TargetType="ListBoxItem">
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin"
                    Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- أزرار الصف -->
        <Style x:Key="RowIconButton"
                TargetType="Button"
               BasedOn="{StaticResource IconButton}">
            <Setter Property="Width"
                    Value="28"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="MinWidth"
                    Value="28"/>
            <Setter Property="MinHeight"
                    Value="28"/>
            <Setter Property="Margin"
                    Value="2,0"/>
        </Style>

        <Style x:Key="RowDangerButton"
                TargetType="Button"
               BasedOn="{StaticResource RowIconButton}">
            <Setter Property="Foreground"
                    Value="{StaticResource DangerBrush}"/>
        </Style>

        <!-- نصوص الخلايا -->
        <Style x:Key="CellText"
                TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="CellLatin"
                TargetType="TextBlock"
               BasedOn="{StaticResource LatinText}">
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
        </Style>

        <!-- جدول الكتب (وضع التصفح) -->
        <Style x:Key="BooksGridStyle"
                TargetType="DataGrid"
               BasedOn="{StaticResource ReviewDataGrid}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearching}"
                        Value="True">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- جدول النتائج (وضع البحث) -->
        <Style x:Key="ResultsGridStyle"
                TargetType="DataGrid"
               BasedOn="{StaticResource ReviewDataGrid}">
            <Setter Property="Visibility"
                    Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearching}"
                        Value="True">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- زر مسح البحث -->
        <Style x:Key="ClearSearchButton"
                TargetType="Button"
               BasedOn="{StaticResource IconButton}">
            <Setter Property="Visibility"
                    Value="Collapsed"/>
            <Setter Property="Margin"
                    Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearching}"
                        Value="True">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= الشريط العلوي ================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                    <Border Width="4"
                            Height="28"
                            CornerRadius="2"
                            Background="{StaticResource AccentBrush}"/>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="أرشيف كتب فحص الأدوية"
                                   Style="{StaticResource PageTitleText}"
                                   FontSize="19"/>
                        <TextBlock Text="{Binding ArchiveSummaryText}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                            Click="AddCompany_Click">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}"
                                    Margin="0,0,10,0"
                                    Click="Trash_Click">
                                <StackPanel Orientation="Horizontal">
                                    <mi:MaterialIcon Kind="DeleteOutline"
                                            Width="18"
                                            Height="18"/>
                                    <TextBlock Text="سلة المحذوفات"
                                            Margin="8,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                            <mi:MaterialIcon Kind="DomainPlus"
                                    Width="18"
                                    Height="18"/>
                            <TextBlock Text="شركة جديدة"
                                    Margin="8,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0"
                            Click="AddBooks_Click">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="FilePlusOutline"
                                    Width="18"
                                    Height="18"/>
                            <TextBlock Text="إضافة كتب"
                                    Margin="8,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= شريط التقدم ================= -->
        <ProgressBar Grid.Row="1"
                     Style="{StaticResource ThinProgressBar}"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

        <!-- ================= البحث ================= -->
        <Grid Grid.Row="2"
                Margin="20,20,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource FieldBorder}"
                    Height="48">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <mi:MaterialIcon Grid.Column="0"
                                     Kind="Magnify"
                                     Width="20"
                            Height="20"
                                     Margin="14,0,6,0"
                                     Foreground="{StaticResource TextMutedBrush}"/>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Style="{StaticResource InlineTextBox}"
                             BorderThickness="0"
                             FontSize="15"
                             Padding="6,0"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchBox_KeyDown"/>

                    <!-- نص إرشادي يختفي عند الكتابة -->
                    <TextBlock Grid.Column="1"
                               Text="امسح الباركود أو اكتب رقم التشغيلة أو اسم المادة أو الشركة"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="14"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearching}"
                                            Value="False">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="2"
                            Style="{StaticResource ClearSearchButton}"
                            ToolTip="مسح البحث"
                            Click="ClearSearch_Click">
                        <mi:MaterialIcon Kind="Close"
                                Width="16"
                                Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Height="48"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="SearchMode"
                            Style="{StaticResource SegmentButton}"
                                 Content="الكل"
                            Tag="All"
                            IsChecked="True"
                                 Click="SearchMode_Click"/>
                    <RadioButton GroupName="SearchMode"
                            Style="{StaticResource SegmentButton}"
                                 Content="Batch Number"
                            Tag="Batch"
                                 Click="SearchMode_Click"/>
                    <RadioButton GroupName="SearchMode"
                            Style="{StaticResource SegmentButton}"
                                 Content="المادة"
                            Tag="Material"
                                 Click="SearchMode_Click"/>
                    <RadioButton GroupName="SearchMode"
                            Style="{StaticResource SegmentButton}"
                                 Content="الشركة"
                            Tag="Company"
                                 Click="SearchMode_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= المحتوى ================= -->
        <Grid Grid.Row="3"
                Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== الشركات ===== -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="الشركات"
                               Style="{StaticResource SectionTitleText}"
                               Margin="20,18,20,12"/>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,0">
                        <ListBox BorderThickness="0"
                                 Background="Transparent"
                                 Padding="10"
                                 FlowDirection="LeftToRight"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource CompanyItem}"
                                 ItemsSource="{Binding Companies}"
                                 SelectedItem="{Binding SelectedCompany, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding CompanyName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontWeight="Medium"/>

                                        <Border Grid.Column="1"
                                                Background="{StaticResource SurfaceAltBrush}"
                                                CornerRadius="10"
                                                Padding="8,1"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="{Binding TotalBooks}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== الكتب / النتائج ===== -->
            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                            Margin="24,18,24,14">
                        <TextBlock Text="{Binding ContentTitle}"
                                   Style="{StaticResource SectionTitleText}"
                                   FlowDirection="LeftToRight"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ContentSummary}"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>

                            <!-- جدول الكتب -->
                            <DataGrid x:Name="BooksGrid"
                                      Style="{StaticResource BooksGridStyle}"
                                      ItemsSource="{Binding Books}"
                                      MouseDoubleClick="BooksGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="48">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <mi:MaterialIcon Kind="FilePdfBox"
                                                                 Width="22"
                                                        Height="22"
                                                                 Foreground="{StaticResource DangerBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="رقم الكتاب"
                                            Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding BookNumberText}"
                                                           Style="{StaticResource CellLatin}"
                                                           FontWeight="Medium"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="الشركة"
                                            Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CompanyName}"
                                                           Style="{StaticResource CellLatin}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="تاريخ الكتاب"
                                            Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding BookDateText}"
                                                           Style="{StaticResource CellLatin}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="المواد"
                                            Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MaterialCountText}"
                                                           Style="{StaticResource CellText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="تاريخ الإضافة"
                                            Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AddedDateText}"
                                                           Style="{StaticResource CellLatin}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="124">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource RowIconButton}"
                                                            ToolTip="فتح الـ PDF"
                                                            Click="BookOpen_Click">
                                                        <mi:MaterialIcon Kind="FilePdfBox"
                                                                Width="18"
                                                                Height="18"/>
                                                    </Button>
                                                    <Button Style="{StaticResource RowIconButton}"
                                                            ToolTip="تعديل الكتاب"
                                                            Click="BookEdit_Click">
                                                        <mi:MaterialIcon Kind="Pencil"
                                                                Width="17"
                                                                Height="17"/>
                                                    </Button>
                                                    <Button Style="{StaticResource RowDangerButton}"
                                                            ToolTip="حذف الكتاب"
                                                            Click="BookDelete_Click">
                                                        <mi:MaterialIcon Kind="DeleteOutline"
                                                                Width="18"
                                                                Height="18"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- جدول نتائج البحث -->
                            <DataGrid x:Name="ResultsGrid"
                                      Style="{StaticResource ResultsGridStyle}"
                                      ItemsSource="{Binding Results}"
                                      MouseDoubleClick="ResultsGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="المادة"
                                            Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MaterialName}"
                                                           Style="{StaticResource CellLatin}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Batch Number"
                                            Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding BatchNumber}"
                                                           Style="{StaticResource CellLatin}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="الشركة"
                                            Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CompanyName}"
                                                           Style="{StaticResource CellLatin}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="رقم الكتاب"
                                            Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding BookNumberText}"
                                                           Style="{StaticResource CellLatin}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="تاريخ الكتاب"
                                            Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding BookDateText}"
                                                           Style="{StaticResource CellLatin}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="88">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource RowIconButton}"
                                                            ToolTip="فتح الـ PDF"
                                                            Click="ResultOpen_Click">
                                                        <mi:MaterialIcon Kind="FilePdfBox"
                                                                Width="18"
                                                                Height="18"/>
                                                    </Button>
                                                    <Button Style="{StaticResource RowIconButton}"
                                                            ToolTip="تعديل الكتاب"
                                                            Click="ResultEdit_Click">
                                                        <mi:MaterialIcon Kind="Pencil"
                                                                Width="17"
                                                                Height="17"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- لا توجد كتب -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BooksEmpty}"
                                                    Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <mi:MaterialIcon Kind="FilePdfBox"
                                        Width="44"
                                        Height="44"
                                                 Foreground="{StaticResource BorderStrongBrush}"/>
                                <TextBlock Text="لا توجد كتب بعد"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"/>
                            </StackPanel>

                            <!-- لا توجد نتائج -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultsEmpty}"
                                                    Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <mi:MaterialIcon Kind="Magnify"
                                        Width="44"
                                        Height="44"
                                                 Foreground="{StaticResource BorderStrongBrush}"/>
                                <TextBlock Text="{Binding ResultsSummary}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>