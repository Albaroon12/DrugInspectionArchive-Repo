<Window x:Class="DrugInspectionArchive.Views.BookViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:DrugInspectionArchive.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="عرض الكتاب"
        Width="1100" Height="820"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="24" CornerRadius="2"
                            Background="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="LabelText"
                               Style="{StaticResource LatinText}"
                               FontSize="17" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}"
                            Click="Share_Click">
                        <StackPanel Orientation="Horizontal">
                            <mi:Icon Kind="Share" Width="18" Height="18"/>
                            <TextBlock Text="مشاركة" Margin="8,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0"
                            Click="Print_Click">
                        <StackPanel Orientation="Horizontal">
                            <mi:Icon Kind="Printer" Width="18" Height="18"/>
                            <TextBlock Text="طباعة" Margin="8,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="PdfViewer" FlowDirection="LeftToRight"/>

            <Border x:Name="PdfErrorPanel"
                    Visibility="Collapsed"
                    Background="{StaticResource SurfaceBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center" MaxWidth="420">
                    <mi:Icon Kind="AlertCircle" Width="36" Height="36"
                             Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock x:Name="PdfErrorText"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>