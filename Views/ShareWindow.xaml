<Window x:Class="DrugInspectionArchive.Views.ShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:DrugInspectionArchive.Controls"
        Title="مشاركة الكتاب"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">

    <Window.Resources>
        <!-- بطاقة إجراء -->
        <Style x:Key="ShareCard" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FillSoftBrush}"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <Grid>
                                <Border x:Name="Overlay"
                                        Background="Black" Opacity="0"
                                        CornerRadius="14"
                                        IsHitTestVisible="False"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.05"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- الترويسة -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="4" Height="26" CornerRadius="2"
                        Background="{DynamicResource AccentBrush}"/>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="مشاركة الكتاب"
                               Style="{StaticResource PageTitleText}"
                               FontSize="18"/>
                    <TextBlock x:Name="LabelText"
                               Style="{StaticResource LatinText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12.5" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Margin="24,22,24,8">

            <!-- واتساب -->
            <Button Style="{StaticResource ShareCard}" Click="WhatsApp_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12"
                            Background="#E3F5E9" VerticalAlignment="Top">
                        <mi:Icon Kind="WhatsApp" Width="22" Height="22"
                                 Foreground="{StaticResource SuccessBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="واتساب لسطح المكتب" FontWeight="Bold"/>
                        <TextBlock Text="ينسخ الملف ويفتح واتساب، اختر المحادثة ثم اضغط Ctrl+V"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- بلوتوث -->
            <Button Style="{StaticResource ShareCard}" Click="Bluetooth_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12"
                            Background="{DynamicResource AccentSoftBrush}"
                            VerticalAlignment="Top">
                        <mi:Icon Kind="Bluetooth" Width="22" Height="22"
                                 Foreground="{DynamicResource AccentBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="بلوتوث" FontWeight="Bold"/>
                        <TextBlock Text="إرسال الملف إلى جهاز مقترن عبر معالج بلوتوث في ويندوز"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- نسخ الملف -->
            <Button Style="{StaticResource ShareCard}" Click="Copy_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12"
                            Background="{StaticResource FillBrush}"
                            VerticalAlignment="Top">
                        <mi:Icon Kind="Copy" Width="22" Height="22"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="نسخ الملف" FontWeight="Bold"/>
                        <TextBlock Text="للصقه في أي تطبيق أو بريد أو مجلد"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- إظهار في المجلد -->
            <Button Style="{StaticResource ShareCard}" Click="Folder_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12"
                            Background="{StaticResource FillBrush}"
                            VerticalAlignment="Top">
                        <mi:Icon Kind="Folder" Width="22" Height="22"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="إظهار في المجلد" FontWeight="Bold"/>
                        <TextBlock Text="فتح مجلد الملف في مستكشف ويندوز"
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <TextBlock x:Name="StatusText"
                       Style="{StaticResource CaptionText}"
                       Foreground="{StaticResource SuccessBrush}"
                       TextWrapping="Wrap"
                       Margin="4,4,4,0"
                       MinHeight="20"/>
        </StackPanel>

        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14" Margin="0,8,0,0">
            <Button Style="{StaticResource SecondaryButton}"
                    Content="إغلاق" MinWidth="96"
                    HorizontalAlignment="Left"
                    Click="Close_Click"/>
        </Border>
    </StackPanel>
</Window>