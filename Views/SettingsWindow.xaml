<Window x:Class="DrugInspectionArchive.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="الإعدادات"
        Width="640" Height="680"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="4" Height="26" CornerRadius="2"
                        Background="{StaticResource AccentBrush}"/>
                <TextBlock Text="الإعدادات"
                           Style="{StaticResource PageTitleText}"
                           FontSize="18" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- البحث والعرض -->
                <Border Style="{StaticResource PanelBorder}" Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="البحث والعرض"
                                   Style="{StaticResource SectionTitleText}"/>

                        <TextBlock Text="نطاق البحث الافتراضي"
                                   Style="{StaticResource FieldLabelText}"
                                   Margin="0,16,0,8"/>
                        <StackPanel x:Name="ModeChips" Orientation="Horizontal">
                            <RadioButton GroupName="M" Tag="All" Content="الكل"
                                         Style="{StaticResource SegmentButton}"
                                         Click="Mode_Click"/>
                            <RadioButton GroupName="M" Tag="Batch" Content="Batch Number"
                                         Style="{StaticResource SegmentButton}" Margin="8,0,0,0"
                                         Click="Mode_Click"/>
                            <RadioButton GroupName="M" Tag="Material" Content="المادة"
                                         Style="{StaticResource SegmentButton}" Margin="8,0,0,0"
                                         Click="Mode_Click"/>
                            <RadioButton GroupName="M" Tag="Company" Content="الشركة"
                                         Style="{StaticResource SegmentButton}" Margin="8,0,0,0"
                                         Click="Mode_Click"/>
                        </StackPanel>

                        <TextBlock Text="ترتيب الكتب الافتراضي"
                                   Style="{StaticResource FieldLabelText}"
                                   Margin="0,18,0,8"/>
                        <StackPanel x:Name="SortChips" Orientation="Horizontal">
                            <RadioButton GroupName="S" Tag="Added" Content="الأحدث إضافة"
                                         Style="{StaticResource SegmentButton}"
                                         Click="Sort_Click"/>
                            <RadioButton GroupName="S" Tag="BookDate" Content="تاريخ الكتاب"
                                         Style="{StaticResource SegmentButton}" Margin="8,0,0,0"
                                         Click="Sort_Click"/>
                            <RadioButton GroupName="S" Tag="BookNumber" Content="رقم الكتاب"
                                         Style="{StaticResource SegmentButton}" Margin="8,0,0,0"
                                         Click="Sort_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- التخزين -->
                <Border Style="{StaticResource PanelBorder}" Padding="22,18" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="التخزين"
                                   Style="{StaticResource SectionTitleText}"/>

                        <TextBlock Text="مجلد بيانات البرنامج"
                                   Style="{StaticResource FieldLabelText}"
                                   Margin="0,16,0,8"/>
                        <Border Style="{StaticResource FieldBorder}" Padding="12,10">
                            <TextBlock x:Name="DataPathText"
                                       Style="{StaticResource LatinText}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Click="OpenData_Click">
                                <StackPanel Orientation="Horizontal">
                                    <mi:MaterialIcon Kind="FolderOpenOutline" Width="18" Height="18"/>
                                    <TextBlock Text="فتح مجلد البيانات" Margin="8,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0"
                                    Click="OpenBackups_Click">
                                <StackPanel Orientation="Horizontal">
                                    <mi:MaterialIcon Kind="FolderOpenOutline" Width="18" Height="18"/>
                                    <TextBlock Text="مجلد النسخ الاحتياطية" Margin="8,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="SizeText"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <!-- الصيانة -->
                <Border Style="{StaticResource PanelBorder}" Padding="22,18" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="الصيانة"
                                   Style="{StaticResource SectionTitleText}"/>

                        <Button Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0"
                                Click="Normalize_Click">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="Cog" Width="18" Height="18"/>
                                <TextBlock Text="توحيد أسماء الملفات" Margin="8,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <Button Style="{StaticResource PrimaryButton}"
                    Content="تم" MinWidth="96"
                    HorizontalAlignment="Left"
                    Click="Done_Click"/>
        </Border>
    </Grid>
</Window>