<Window x:Class="DrugInspectionArchive.Views.WarehouseSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:DrugInspectionArchive.Controls"
        xmlns:views="clr-namespace:DrugInspectionArchive.Views"
        Title="إنشاء مذخر"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">

    <StackPanel>
        <StackPanel Margin="32,34,32,0" HorizontalAlignment="Center">
            <Border Width="64" Height="64" CornerRadius="18"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource AccentBrush}">
                <mi:Icon Kind="Building" Width="32" Height="32"
                         Foreground="White"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="إنشاء مذخر"
                       Style="{StaticResource PageTitleText}"
                       FontSize="24"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0"/>
            <TextBlock Text="أرشيف كتب فحص الأدوية"
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Style="{StaticResource PanelBorder}"
                Margin="28,24,28,0" Padding="22,20">
            <views:WarehouseEditor x:Name="Editor"/>
        </Border>

        <Button Style="{StaticResource PrimaryButton}"
                Content="إنشاء المذخر"
                IsDefault="True"
                Height="44"
                Margin="28,20,28,28"
                Click="Create_Click"/>
    </StackPanel>
</Window>