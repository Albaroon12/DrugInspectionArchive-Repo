<Window x:Class="DrugInspectionArchive.Views.AddBooksWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
                  xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                  Title="إضافة كتب الفحص"
                  Width="1380"
        Height="840"
                  MinWidth="1120"
        MinHeight="700"
                  WindowStartupLocation="CenterOwner"
                  Style="{StaticResource AppWindowStyle}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- أزرار تتعطل أثناء المعالجة -->
        <Style x:Key="BusyPrimaryButton"
                TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}"
                        Value="True">
                    <Setter Property="IsEnabled"
                            Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BusySecondaryButton"
                TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}"
                        Value="True">
                    <Setter Property="IsEnabled"
                            Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BusyIconButton"
                TargetType="Button"
               BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}"
                        Value="True">
                    <Setter Property="IsEnabled"
                            Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- عنصر قائمة الملفات -->
        <Style x:Key="QueueItem"
                TargetType="ListBoxItem">
            <Setter Property="Padding"
                    Value="14,11"/>
            <Setter Property="Margin"
                    Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- منطقة الإفلات: حد منقط -->
        <Style x:Key="DropRect"
                TargetType="Rectangle">
            <Setter Property="Stroke"
                    Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="StrokeThickness"
                    Value="1.5"/>
            <Setter Property="StrokeDashArray"
                    Value="5 4"/>
            <Setter Property="RadiusX"
                    Value="8"/>
            <Setter Property="RadiusY"
                    Value="8"/>
            <Setter Property="Fill"
                    Value="{StaticResource SurfaceAltBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid, AncestorLevel=1}}"
                             Value="True">
                    <Setter Property="Stroke"
                            Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= الشريط العلوي ================= -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="4"
                            Height="24"
                            CornerRadius="2"
                            Background="{StaticResource AccentBrush}"/>
                    <TextBlock Text="إضافة كتب الفحص"
                               Style="{StaticResource PageTitleText}"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="14"
                        Padding="12,5"
                        VerticalAlignment="Center">
                </Border>
            </Grid>
        </Border>

        <!-- ================= المحتوى ================= -->
        <Grid Grid.Row="1"
                Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== الإضافة (يمين) ========== -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorder}"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="إضافة ملفات"
                               Style="{StaticResource SectionTitleText}"
                               Margin="0,0,0,18"/>

                    <Grid Grid.Row="1"
                          Background="Transparent"
                          AllowDrop="True"
                          DragOver="DropZone_DragOver"
                          Drop="DropZone_Drop">

                        <Rectangle Style="{StaticResource DropRect}"/>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border Width="64"
                                    Height="64"
                                    CornerRadius="32"
                                    Background="{StaticResource AccentSoftBrush}">
                                <mi:MaterialIcon Kind="Upload"
                                                 Width="28"
                                        Height="28"
                                                 Foreground="{StaticResource AccentBrush}"/>
                            </Border>

                            <TextBlock Text="اسحب ملفات PDF وأفلتها هنا"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       Margin="0,18,0,16"/>

                            <Button Style="{StaticResource BusySecondaryButton}"
                                    HorizontalAlignment="Center"
                                    Click="ChooseFiles_Click">
                                <StackPanel Orientation="Horizontal">
                                    <mi:MaterialIcon Kind="FolderOpenOutline"
                                                     Width="18"
                                            Height="18"/>
                                    <TextBlock Text="اختيار من الجهاز"
                                               Margin="8,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ========== قائمة الملفات (يسار) ========== -->
            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- رأس القائمة -->
                    <Grid Grid.Row="0"
                            Margin="24,20,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                Orientation="Horizontal">
                            <TextBlock Text="الملفات المحددة"
                                       Style="{StaticResource SectionTitleText}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PendingCountText}"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                            <Button Style="{StaticResource BusyIconButton}"
                                    ToolTip="إزالة الملف المحدد"
                                    Click="RemoveSelected_Click">
                                <mi:MaterialIcon Kind="DeleteOutline"
                                        Width="18"
                                        Height="18"/>
                            </Button>
                            <Button Style="{StaticResource BusyIconButton}"
                                    ToolTip="إفراغ القائمة"
                                    Margin="4,0,0,0"
                                    Click="ClearFiles_Click">
                                <mi:MaterialIcon Kind="DeleteSweep"
                                        Width="18"
                                        Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <ListBox x:Name="PendingFilesList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="16,14"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource QueueItem}"
                                     ItemsSource="{Binding PendingFiles}"
                                     SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                                     SelectionChanged="PendingFilesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <mi:MaterialIcon Grid.Column="0"
                                                             Kind="FilePdfBox"
                                                             Width="28"
                                                    Height="28"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource DangerBrush}"/>

                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OriginalFileName}"
                                                           Style="{StaticResource LatinText}"
                                                           FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,5,0,0"
                                                            ToolTip="{Binding ConfidenceText}">
                                                    <mi:MaterialIcon Width="14"
                                                            Height="14"
                                                                     VerticalAlignment="Center">
                                                        <mi:MaterialIcon.Style>
                                                            <Style TargetType="mi:MaterialIcon">
                                                                <Setter Property="Kind"
                                                                        Value="ClockOutline"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource TextMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOcrCompleted}"
                                                                                 Value="True">
                                                                        <Setter Property="Kind"
                                                                                Value="CheckCircleOutline"/>
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ProcessingStatus}"
                                                                                 Value="فشلت القراءة">
                                                                        <Setter Property="Kind"
                                                                                Value="AlertCircleOutline"/>
                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </mi:MaterialIcon.Style>
                                                    </mi:MaterialIcon>

                                                    <TextBlock Text="{Binding ProcessingStatus}"
                                                               Style="{StaticResource CaptionText}"
                                                               Margin="6,0,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SizeText}"
                                                       Style="{StaticResource MutedText}"
                                                       FlowDirection="LeftToRight"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- حالة القائمة الفارغة -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PendingCount}"
                                                    Value="0">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <mi:MaterialIcon Kind="FilePdfBox"
                                                 Width="44"
                                        Height="44"
                                                 Foreground="{StaticResource BorderStrongBrush}"/>
                                <TextBlock Text="لا توجد ملفات"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= شريط التقدم ================= -->
        <ProgressBar Grid.Row="2"
                     Style="{StaticResource ThinProgressBar}"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>


        <Border Grid.Column="2"
                Style="{StaticResource PanelBorder}"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="18,10">
                    <TextBlock Text="الكتاب الأصلي"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12.5"/>
                </Border>

                <Grid Grid.Row="1">
                    <wv2:WebView2 x:Name="PdfViewer"
                            FlowDirection="LeftToRight"/>

                    <Border x:Name="PdfErrorPanel"
                            Visibility="Collapsed"
                            Background="{StaticResource SurfaceBrush}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="420">
                            <mi:MaterialIcon Kind="AlertCircleOutline"
                                             Width="36"
                                    Height="36"
                                             Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock x:Name="PdfErrorText"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

    <!-- ================= الشريط السفلي ================= -->
    <Border Grid.Row="3"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="24,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>

            <StackPanel Grid.Column="1"
                    Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}"
                        Content="إغلاق"
                        MinWidth="84"
                        Click="Close_Click"/>

                <Button x:Name="ReviewSelectedButton"
                        Style="{StaticResource SecondaryButton}"
                        Margin="10,0,0,0"
                        IsEnabled="False"
                        Click="ReviewSelected_Click">
                    <StackPanel Orientation="Horizontal">
                        <mi:MaterialIcon Kind="Pencil"
                                Width="17"
                                Height="17"/>
                        <TextBlock Text="مراجعة الكتاب المحدد"
                                   Margin="8,0,0,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BusyPrimaryButton}"
                        Margin="10,0,0,0"
                        Click="StartOcr_Click">
                    <StackPanel Orientation="Horizontal">
                        <mi:MaterialIcon Kind="Play"
                                Width="18"
                                Height="18"/>
                        <TextBlock Text="بدء قراءة الملفات"
                                   Margin="8,0,0,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>