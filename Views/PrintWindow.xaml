<Window x:Class="DrugInspectionArchive.Views.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:DrugInspectionArchive.Controls"
        Title="طباعة الكتاب"
        Width="1100"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- الترويسة -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,16">
            <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
                <Border Width="4"
                        Height="26"
                        CornerRadius="2"
                        Background="{DynamicResource AccentBrush}"/>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="طباعة الكتاب"
                               Style="{StaticResource PageTitleText}"
                               FontSize="18"/>
                    <TextBlock x:Name="LabelText"
                               Style="{StaticResource LatinText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12.5"
                            Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
                Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"
                        MinWidth="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- الإعدادات -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,20">

                        <TextBlock Text="الطابعة"
                                Style="{StaticResource FieldLabelText}"/>
                        <ComboBox x:Name="QueueBox"
                                  Style="{StaticResource LatinComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="عدد النسخ"
                                   Style="{StaticResource FieldLabelText}"
                                   Margin="0,20,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Width="40"
                                    Height="40"
                                    MinWidth="40"
                                    Padding="0"
                                    Click="CopiesMinus_Click">
                                <TextBlock Text="−"
                                        FontSize="18"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <TextBox x:Name="CopiesBox"
                                     Style="{StaticResource LatinInputTextBox}"
                                     Width="72"
                                    Margin="8,0"
                                     TextAlignment="Center"
                                     Text="1"/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Width="40"
                                    Height="40"
                                    MinWidth="40"
                                    Padding="0"
                                    Click="CopiesPlus_Click">
                                <TextBlock Text="+"
                                        FontSize="18"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="الصفحات"
                                   Style="{StaticResource FieldLabelText}"
                                   Margin="0,20,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="AllPagesChip"
                                    GroupName="Pages"
                                         Content="الكل"
                                    IsChecked="True"
                                         Style="{StaticResource SegmentButton}"
                                         Checked="PagesMode_Changed"/>
                            <RadioButton x:Name="RangeChip"
                                    GroupName="Pages"
                                         Content="نطاق محدد"
                                         Style="{StaticResource SegmentButton}"
                                         Margin="8,0,0,0"
                                         Checked="PagesMode_Changed"/>
                        </StackPanel>
                        <TextBox x:Name="RangeBox"
                                 Style="{StaticResource LatinInputTextBox}"
                                 Margin="0,10,0,0"
                                 IsEnabled="False"
                                 ToolTip="مثال: 1-3, 5"/>

                        <TextBlock Text="اللون"
                                   Style="{StaticResource FieldLabelText}"
                                   Margin="0,20,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ColorChip"
                                    GroupName="Color"
                                         Content="ملوّن"
                                    IsChecked="True"
                                         Style="{StaticResource SegmentButton}"/>
                            <RadioButton x:Name="MonoChip"
                                    GroupName="Color"
                                         Content="أبيض وأسود"
                                         Style="{StaticResource SegmentButton}"
                                         Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- المعاينة -->
            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorder}"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="18,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="المعاينة"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12.5"/>
                            <TextBlock x:Name="PagesCountText"
                                       Grid.Column="1"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12.5"/>
                        </Grid>
                    </Border>

                    <ProgressBar x:Name="LoadBar"
                            Grid.Row="1"
                                 Style="{StaticResource ThinProgressBar}"
                                 IsIndeterminate="True"/>

                    <ScrollViewer Grid.Row="2"
                                  Background="{StaticResource FillSoftBrush}"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PagesList"
                                Margin="0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14"
                                                HorizontalAlignment="Center">
                                        <Border Background="White"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                MaxWidth="560">
                                            <Image Source="{Binding Image}"
                                                   Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Text="{Binding Number}"
                                                   Style="{StaticResource LatinText}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- الشريط السفلي -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="إلغاء"
                            MinWidth="84"
                            Click="Cancel_Click"/>
                    <Button x:Name="PrintButton"
                            Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0"
                            Click="Print_Click">
                        <StackPanel Orientation="Horizontal">
                            <mi:Icon Kind="Printer"
                                    Width="18"
                                    Height="18"/>
                            <TextBlock Text="طباعة"
                                    Margin="8,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>