<UserControl x:Class="DrugInspectionArchive.Views.WarehouseEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:DrugInspectionArchive.Controls">

    <UserControl.Resources>
        <!-- دائرة لون -->
        <Style x:Key="AccentSwatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="38" Height="38" Background="Transparent">
                            <Ellipse x:Name="Ring"
                                     Stroke="{Binding Tag.Brush, RelativeSource={RelativeSource TemplatedParent}}"
                                     StrokeThickness="2"
                                     Opacity="0"/>
                            <Ellipse Margin="5"
                                     Fill="{Binding Tag.Brush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <mi:Icon x:Name="Tick" Kind="Check" Width="16" Height="16"
                                     Foreground="White"
                                     Visibility="Collapsed"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- الشعار -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Width="88" Height="88">
                <Border x:Name="InitialBadge"
                        CornerRadius="20"
                        Background="{DynamicResource AccentBrush}">
                    <TextBlock x:Name="InitialText"
                               FontSize="38" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="LogoBadge"
                        CornerRadius="20"
                        Background="White"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Image x:Name="LogoImage" Margin="10" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left"
                        Click="PickLogo_Click">
                    <StackPanel Orientation="Horizontal">
                        <mi:Icon Kind="Image" Width="18" Height="18"/>
                        <TextBlock Text="اختيار شعار" Margin="8,0,0,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="RemoveLogoButton"
                        Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left"
                        Margin="0,6,0,0"
                        Visibility="Collapsed"
                        Click="RemoveLogo_Click">
                    <StackPanel Orientation="Horizontal">
                        <mi:Icon Kind="Close" Width="16" Height="16"/>
                        <TextBlock Text="إزالة الشعار" Margin="8,0,0,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- الاسم -->
        <TextBlock Text="اسم المذخر"
                   Style="{StaticResource FieldLabelText}"
                   Margin="0,22,0,6"/>
        <TextBox x:Name="NameBox"
                 Style="{StaticResource InputTextBox}"
                 MaxLength="80"
                 TextChanged="NameBox_TextChanged"/>

        <!-- اللون -->
        <TextBlock Text="اللون"
                   Style="{StaticResource FieldLabelText}"
                   Margin="0,20,0,4"/>
        <StackPanel x:Name="SwatchPanel" Orientation="Horizontal"/>
    </StackPanel>
</UserControl>