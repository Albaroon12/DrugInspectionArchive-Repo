<Window x:Class="DrugInspectionArchive.Views.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="سلة المحذوفات"
        Width="980" Height="620"
        MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">

    <Window.Resources>
        <Style x:Key="RowIconButton" TargetType="Button"
               BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <Style x:Key="CellLatin" TargetType="TextBlock"
               BasedOn="{StaticResource LatinText}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="26" CornerRadius="2"
                            Background="{StaticResource AccentBrush}"/>
                    <TextBlock Text="سلة المحذوفات"
                               Style="{StaticResource PageTitleText}"
                               FontSize="18"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="14"
                        Padding="12,5"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="CountText"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12.5"
                               FontWeight="Medium"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="20" Style="{StaticResource PanelBorder}">
            <Grid>
                <DataGrid x:Name="TrashGrid"
                          Style="{StaticResource ReviewDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="رقم الكتاب" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BookNumberText}"
                                               Style="{StaticResource CellLatin}"
                                               FontWeight="Medium"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="الشركة" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CompanyName}"
                                               Style="{StaticResource CellLatin}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="تاريخ الكتاب" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BookDateText}"
                                               Style="{StaticResource CellLatin}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="عدد السجلات" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MaterialCount}"
                                               Style="{StaticResource CellLatin}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="تاريخ الحذف" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeletedAtText}"
                                               Style="{StaticResource CellLatin}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Button Style="{StaticResource RowIconButton}"
                                                ToolTip="فتح الـ PDF"
                                                Click="Open_Click">
                                            <mi:MaterialIcon Kind="FilePdfBox" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource RowIconButton}"
                                                ToolTip="استعادة الكتاب"
                                                Foreground="{StaticResource SuccessBrush}"
                                                Click="Restore_Click">
                                            <mi:MaterialIcon Kind="Restore" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource RowIconButton}"
                                                ToolTip="حذف نهائي"
                                                Foreground="{StaticResource DangerBrush}"
                                                Click="Purge_Click">
                                            <mi:MaterialIcon Kind="DeleteForever" Width="19" Height="19"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="EmptyPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                    <mi:MaterialIcon Kind="DeleteOutline" Width="44" Height="44"
                                     Foreground="{StaticResource BorderStrongBrush}"/>
                    <TextBlock Text="سلة المحذوفات فارغة"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="EmptyTrashButton"
                        Grid.Column="0"
                        Style="{StaticResource GhostButton}"
                        Foreground="{StaticResource DangerBrush}"
                        Click="EmptyTrash_Click">
                    <StackPanel Orientation="Horizontal">
                        <mi:MaterialIcon Kind="DeleteForever" Width="18" Height="18"/>
                        <TextBlock Text="إفراغ السلة"
                                   Margin="8,0,0,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource SecondaryButton}"
                        Content="إغلاق" MinWidth="84"
                        Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>