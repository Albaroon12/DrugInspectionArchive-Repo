<Window x:Class="DrugInspectionArchive.Views.EditBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="تعديل كتاب الفحص"
        Width="780"
        Height="760"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="DateHintText"
                TargetType="TextBlock"
               BasedOn="{StaticResource MutedText}">
            <Setter Property="Text"
                    Value="تاريخ غير صالح، الصيغة: 2025/05/25"/>
            <Setter Property="Foreground"
                    Value="{StaticResource DangerBrush}"/>
            <Setter Property="Margin"
                    Value="0,6,0,0"/>
            <Setter Property="Visibility"
                    Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBookDateInvalid}"
                        Value="True">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== الترويسة ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                    <Border Width="4"
                            Height="26"
                            CornerRadius="2"
                            Background="{StaticResource AccentBrush}"/>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="تعديل كتاب الفحص"
                                   Style="{StaticResource PageTitleText}"
                                   FontSize="18"/>
                        <TextBlock Text="{Binding FileName}"
                                   Style="{StaticResource LatinText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="360"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center"
                        Click="OpenPdf_Click">
                    <StackPanel Orientation="Horizontal">
                        <mi:MaterialIcon Kind="FilePdfBox"
                                Width="18"
                                Height="18"/>
                        <TextBlock Text="فتح الـ PDF"
                                   Margin="8,0,0,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===== المحتوى ===== -->
        <Grid Grid.Row="1"
                Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="540"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0"
                                 Style="{StaticResource ThinProgressBar}"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                    <!-- بيانات الكتاب -->
                    <StackPanel Grid.Row="1"
                            Margin="24,20,24,20">

                        <TextBlock Text="الشركة المصنعة"
                                   Style="{StaticResource FieldLabelText}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Style="{StaticResource LatinComboBox}"
                                      ItemsSource="{Binding Companies}"
                                      SelectedItem="{Binding SelectedCompany, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Column="2"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="38"
                                    Height="38"
                                    MinWidth="38"
                                    MinHeight="38"
                                    Padding="0"
                                    ToolTip="إضافة شركة جديدة"
                                    Click="AddCompany_Click">
                                <mi:MaterialIcon Kind="Plus"
                                        Width="18"
                                        Height="18"/>
                            </Button>
                        </Grid>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="رقم الكتاب"
                                           Style="{StaticResource FieldLabelText}"/>
                                <TextBox Style="{StaticResource LatinInputTextBox}"
                                         Text="{Binding BookNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تاريخ الكتاب"
                                           Style="{StaticResource FieldLabelText}"/>

                                <Border x:Name="DateField">
                                    <Border.Style>
                                        <Style TargetType="Border"
                                               BasedOn="{StaticResource FieldBorder}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBookDateInvalid}"
                                                             Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Style="{StaticResource InlineLatinTextBox}"
                                                 Padding="10,0"
                                                 BorderThickness="0"
                                                 Text="{Binding BookDateText, UpdateSourceTrigger=PropertyChanged}"/>

                                        <ToggleButton x:Name="CalendarToggle"
                                                      Grid.Column="1"
                                                      Style="{StaticResource IconToggleButton}"
                                                      ToolTip="اختيار من التقويم">
                                            <mi:MaterialIcon Kind="Calendar"
                                                    Width="18"
                                                    Height="18"/>
                                        </ToggleButton>

                                        <Popup IsOpen="{Binding IsChecked, ElementName=CalendarToggle, Mode=TwoWay}"
                                               PlacementTarget="{Binding ElementName=DateField}"
                                               Placement="Bottom"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Margin="0,4,0,0"
                                                    Padding="6"
                                                    Background="{StaticResource SurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <Calendar SelectedDate="{Binding BookDate, Mode=TwoWay}"
                                                          FirstDayOfWeek="Saturday"
                                                          BorderThickness="0"
                                                          GotMouseCapture="Calendar_GotMouseCapture"
                                                          SelectedDatesChanged="Calendar_SelectedDatesChanged"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>

                                <TextBlock Style="{StaticResource DateHintText}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- المواد -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Divider}"
                                VerticalAlignment="Top"/>

                        <Grid Grid.Row="0"
                                Margin="24,18,24,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                <TextBlock Text="المواد وأرقام التشغيلات"
                                           Style="{StaticResource SectionTitleText}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MaterialCount, StringFormat={}{0} مادة}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    MinHeight="34"
                                    Padding="12,0"
                                    Click="AddMaterial_Click">
                                <StackPanel Orientation="Horizontal">
                                    <mi:MaterialIcon Kind="Plus"
                                            Width="16"
                                            Height="16"/>
                                    <TextBlock Text="مادة جديدة"
                                               Margin="6,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="0,1,0,0">
                            <DataGrid x:Name="MaterialsGrid"
                                      Style="{StaticResource ReviewDataGrid}"
                                      ItemsSource="{Binding Materials}"
                                      SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}">
                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <mi:MaterialIcon Width="18"
                                                        Height="18"
                                                                 HorizontalAlignment="Center">
                                                    <mi:MaterialIcon.Style>
                                                        <Style TargetType="mi:MaterialIcon">
                                                            <Setter Property="Kind"
                                                                    Value="CheckCircleOutline"/>
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource SuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsComplete}"
                                                                        Value="False">
                                                                    <Setter Property="Kind"
                                                                            Value="AlertCircleOutline"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource WarningBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </mi:MaterialIcon.Style>
                                                </mi:MaterialIcon>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="المادة"
                                            Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Tag="name"
                                                         Style="{StaticResource RequiredInlineLatinTextBox}"
                                                         Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Batch Number"
                                            Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Tag="batch"
                                                         FontWeight="Medium"
                                                         Style="{StaticResource RequiredInlineLatinTextBox}"
                                                         Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="76">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource IconButton}"
                                                            Width="28"
                                                            Height="28"
                                                            MinWidth="28"
                                                            MinHeight="28"
                                                            ToolTip="إضافة رقم تشغيلة آخر لنفس المادة"
                                                            Click="RowAddBatch_Click">
                                                        <mi:MaterialIcon Kind="Plus"
                                                                Width="16"
                                                                Height="16"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}"
                                                            Width="28"
                                                            Height="28"
                                                            MinWidth="28"
                                                            MinHeight="28"
                                                            Foreground="{StaticResource DangerBrush}"
                                                            ToolTip="حذف السجل"
                                                            Click="RowDelete_Click">
                                                        <mi:MaterialIcon Kind="DeleteOutline"
                                                                Width="16"
                                                                Height="16"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            
                        <Border Grid.Column="2"
                    Style="{StaticResource PanelBorder}"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="18,10">
                        <TextBlock Text="الكتاب الأصلي"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12.5"/>
                    </Border>

                    <Grid Grid.Row="1">
                        <wv2:WebView2 x:Name="PdfViewer" FlowDirection="LeftToRight"/>

                        <Border x:Name="PdfErrorPanel"
                                Visibility="Collapsed"
                                Background="{StaticResource SurfaceBrush}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="420">
                                <mi:MaterialIcon Kind="AlertCircleOutline"
                                                 Width="36" Height="36"
                                                 Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock x:Name="PdfErrorText"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

            <!-- ===== الشريط السفلي ===== -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource GhostButton}"
                            Foreground="{StaticResource DangerBrush}"
                            Click="Delete_Click">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="DeleteOutline"
                                    Width="18"
                                    Height="18"/>
                            <TextBlock Text="حذف الكتاب"
                                       Margin="8,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="إغلاق"
                                MinWidth="84"
                                Click="Close_Click"/>

                        <Button Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0"
                                Click="Save_Click">
                            <StackPanel Orientation="Horizontal">
                                <mi:MaterialIcon Kind="ContentSave"
                                        Width="18"
                                        Height="18"/>
                                <TextBlock Text="حفظ التعديلات"
                                           Margin="8,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
</Window>