<Window x:Class="DrugInspectionArchive.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Style="{StaticResource AppWindowStyle}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="18"
            MinWidth="400"
            MaxWidth="480"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="8"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="4"
                              Opacity="0.22"
                              Color="#1B2430"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,24,24,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconHost"
                        Grid.Column="0"
                        Width="44" Height="44"
                        CornerRadius="22"
                        VerticalAlignment="Top">
                    <mi:MaterialIcon x:Name="IconControl"
                                     Width="24" Height="24"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource SectionTitleText}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageText"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="24,14">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="90"
                            Click="Cancel_Click"/>

                    <Button x:Name="OkButton"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="90"
                            Margin="10,0,0,0"
                            IsDefault="True"
                            Click="Ok_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>